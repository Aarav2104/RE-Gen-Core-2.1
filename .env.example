# Copy this file to .env and fill in your credentials.
# Never commit the real .env file.

RESEARCHGEN_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
RESEARCHGEN_LLM_MODEL=openai/gpt-oss-120b
RESEARCHGEN_LLM_TEMPERATURE=0.2
RESEARCHGEN_LLM_MAX_TOKENS=2048

RESEARCHGEN_EMBEDDING_MODEL=all-MiniLM-L6-v2
RESEARCHGEN_CHUNK_SIZE=900
RESEARCHGEN_CHUNK_OVERLAP=150
RESEARCHGEN_TOP_K=6
RESEARCHGEN_MIN_EVIDENCE_SCORE=0.18
